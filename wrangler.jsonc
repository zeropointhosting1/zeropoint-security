{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys with `npx wrangler deploy`).
  "name": "zeropoint-security",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.ts",
  // Serves the `npm run build` export; only /api/* runs the Worker (live data from Supabase).
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://vhrzezllvfcujlrdxmha.supabase.co",
    // Publishable (anon) key: public by design; RLS only lets it read public.snapshots.
    "SUPABASE_PUBLISHABLE_KEY": "SET_ME"
  },
  "observability": {
    "enabled": true
  }
}
